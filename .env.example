# Copy to .env and keep the real key out of source control.
PIRATE_WEATHER_API_KEY=replace_with_your_pirate_weather_key

# Node selection: Morpheus is the default.
MESH_NODE_IP=192.168.50.46
MESH_NODE_IP_SECONDARY=192.168.50.49
# Listen on channels 5 and 6, and reply on the channel where the request arrived.
MESH_CHANNEL_INDEXES=2,5

# Optional: restrict Nominatim results, for example US or CA.
# LOCATION_COUNTRY_CODES=us
LOG_LEVEL=INFO
